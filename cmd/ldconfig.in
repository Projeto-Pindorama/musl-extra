ME=${0##*/}
VERSION=0.2.2

echo() {
	printf '%s\n' "$*"
}

echo_lines() {
	printf '%s\n' "$@"
}

msg() {
	printf >&2 '%s: %s\n' "$ME" "$*"
}

read_ldso_conf() {
	local conf="$*" d dir file glob line

	# Start with the default "trusted" directories
	set -- /lib /usr/lib
	for file in $conf; do
		test -r "$file" || continue
		$VERBOSE && msg "Reading ${file}"
		while read -r line; do
			line=$(tokenize ${line%%#*})
			if test "${line#include }" != "$line"; then
				glob=${file%/*}/${line#include }
				$VERBOSE && msg "Including ${glob}"
				line=$(read_ldso_conf $glob)
			fi
			for dir in $line; do
				# Ignore missing directories
				test -d "$ROOT$dir" || continue
				# Ignore duplicate directories
				for d; do test "$d" = "$dir" && continue 2; done
				set -- "$@" "$dir"
			done
		done < "$file"
	done

	echo_lines "$@"
}

tokenize() {
	echo "$*" | sed 's/=libc[456]//g;y/:,/  /' | xargs
}

clean_to_base10() {
	n=$(echo -n $1 | sed 's/^0*//g')
	echo -n $(( ${n:-0} ))
}

# Some ELF-related constants.
ELFCLASS32=1
ELFCLASS64=2
ET_DYN=3
SHT_DYNAMIC=6
DT_SONAME=14

# TODO: Implement some form of buffering, some day.
get_SONAME_from_lib() {
	lib="$1"

	# Get the e_indent section of the ELF file.
	# taks note: As I said in the P.O.C. code, I know we could just use
	# file(1) in this one, but, since we're already parsing it anyway...
	e_indent="$(od -An -t c -N16 "$lib")"
	set -- $e_indent
	case "$2$3$4" in
	ELF) e_type=$(clean_to_base10 $(od -An -t u2 -j16 -N2 "$lib"))
		if test $e_type -ne $ET_DYN; then
			msg 'Not an ELF dynamic library.'
			exit 1
		fi
		$VERBOSE &&
			msg "$lib is a valid dynamic ELF file with magic: $e_indent"
		unset e_indent ;;
	*) msg 'Not a valid ELF file'
		exit 1 ;;
	esac

	# A "class" in the ELF header actually corresponds to the
	# "bit-wideness", if you will, of the architecture, while
	# e_machine/EM_* consts correspond to the specific for
	# which the ELF was compiled.
	ELF_class=$(clean_to_base10 $5) # e_ident[EI_CLASS]
	case $ELF_class in
	$ELFCLASS32)
		e_shoff=$(clean_to_base10 $(od -An -t u4 -j$((16 + 2*2 + 3*4)) -N4 "$lib"))
		e_shentsize=$(clean_to_base10 $(od -An -t u2 -j$((16 + 2*2 + 5*4 + 3*2)) -N2 "$lib"))
		e_shnum=$(clean_to_base10 $(od -An -t u2 -j$((16 + 2*2 + 5*4 + 4*2)) -N2 "$lib"))
		Elf_Dyn_size=8
		;;
	$ELFCLASS64)
		e_shoff=$(clean_to_base10 $(od -An -t u8 -j$((16 + 2*2 + 4 + 2*8)) -N8 "$lib"))
		e_shentsize=$(clean_to_base10 $(od -An -t u2 -j$((16 + 2*2 + 4 + 3*8 + 4 + 3*2)) -N2 "$lib"))
		e_shnum=$(clean_to_base10 $(od -An -t u2 -j$((16 + 2*2 + 4 + 3*8 + 4 + 4*2)) -N2 "$lib"))
		Elf_Dyn_size=16
		;;
	esac
	# From now, already set the total size that the
	# Elf{32,64}_Dyn struct will be actually using on the
	# ELF file; there are two entries of equal sizes on
	# it, so we just divide the total size per two.
	EDyn_entry_size=$((Elf_Dyn_size/2))
	$VERBOSE && msg "$lib was built for $((Elf_Dyn_size*4))-bit"

	n=0
	pos=$e_shoff
	while [ $n -lt $e_shnum ]; do
		sh_type=$(clean_to_base10 $(od -An -t u4 -j$((pos + 4)) -N4 "$lib"))
		case $sh_type in
		$SHT_DYNAMIC)
			$VERBOSE &&
				msg "Found the '.dynamic' table of $lib at offset $pos, no. $n"
			# Just bother to look further on the struct
			# if it's actually from our interest.
			# This shall apply even if we buffer it.
			case $ELF_class in
			$ELFCLASS32)
				sh_offset=$(clean_to_base10 $(od -An -t u4 \
						-j$((pos + 4*4)) -N4 "$lib"))
				sh_size=$(clean_to_base10 $(od -An -t u4 \
						-j$((pos + 5*4)) -N4 "$lib"))
				sh_link=$(clean_to_base10 $(od -An -t u4 \
						-j$((pos + 6*4)) -N4 "$lib"))
				sh_entsize=$(clean_to_base10 $(od -An -t u4 \
						-j$((pos + 9*4)) -N4 "$lib"))
				;;
			$ELFCLASS64)
				sh_offset=$(clean_to_base10 $(od -An -t u8 \
						-j$((pos + 2*4 + 2*8)) -N8 "$lib"))
				sh_size=$(clean_to_base10 $(od -An -t u8 \
						-j$((pos + 2*4 + 3*8)) -N8 "$lib"))
				sh_link=$(clean_to_base10 $(od -An -t u4 \
						-j$((pos + 2*4 + 4*8)) -N4 "$lib"))
				sh_entsize=$(clean_to_base10 $(od -An -t u8 \
						-j$((pos + 2*4 + 4*8 + 2*4 + 8)) -N8 "$lib"))
				;;
			esac

			$VERBOSE &&
				msg "Searching '.dynamic' entries on $lib for SONAME offset"
			m=0
			pos2=$sh_offset
			while [ $m -lt $((sh_size/sh_entsize)) ]; do
				dt_tag=$(clean_to_base10 $(od -An -t "u$EDyn_entry_size" \
							-j$pos2 -N $EDyn_entry_size "$lib"))
				case $dt_tag in
				$DT_SONAME)
					$VERBOSE &&
						msg "Found entry with dt_tag=DT_SONAME at $pos2 on $lib"

					# Just "poke" the file
					# for dt_val if we're
					# sure it contains the
					# offset for SONAME.
					dt_val=$(clean_to_base10 $(od -An -t "u$EDyn_entry_size" \
								-j$((pos2 + $EDyn_entry_size)) \
								-N $EDyn_entry_size "$lib"))
					break ;;
				esac
				pos2=$((pos2 + sh_entsize))
				m=$((m + 1))
			done
			unset Elf_Dyn_size EDyn_entry_size dt_tag sh_offset pos2 m

			# taks note: sh_link, in the context of SHT_DYNAMIC, means
			# that the header remits to a n-th section header table,
			# and that's why we have it times the sh_entsize plus
			# the e_shoff.
			dynstr_sh_pos=$((e_shoff + (sh_link * e_shentsize)))
			case $ELF_class in
			$ELFCLASS32)
				dynstr_sh_offset_pos=$((dynstr_sh_pos + 4*4)) ;;
			$ELFCLASS64)
				dynstr_sh_offset_pos=$((dynstr_sh_pos + 2*4 + 2*8)) ;;
			esac

			# Get the SONAME position at the file (string section).
			dynstr_sh_offset=$(clean_to_base10 $(od -An -t u4 \
							-j$dynstr_sh_offset_pos -N4 "$lib"))
			SONAME_pos=$((dynstr_sh_offset + dt_val))
			$VERBOSE && msg "Found SONAME for $lib at $SONAME_pos"

			# Then just get the string, remove spaces (from the
			# od(1) output) and trim down to the first '\0', which
			# is the separator.
			_SONAME="$(od -An -tc -j$SONAME_pos -N256 "$lib" |
					sed -e ':a' -e 'N' -e '$!ba' -e 's/\n//g; s/ //g')"
			SONAME=${_SONAME%%'\0'*}

			unset dt_val dynstr_sh_offset dynstr_sh_offset_pos \
				e_shoff e_shentsize e_shnum SONAME_pos _SONAME
			break ;;
		esac
		pos=$((pos + e_shentsize))
		n=$(( n + 1 ))
	done
	echo -n "$SONAME"
}

LDSO_CACHE="/etc/ld.so.cache"
LDSO_CONF="/etc/ld.so.conf"
LIBRARY_MODE=false
ONLYARG_MODE=false
PRINT_CACHE=false
PRINT_VERSION=false
ROOT=
UPDATE_CACHE=true
UPDATE_LINKS=true
VERBOSE=false

while getopts ":c:C:Df:ilnNpr:vVX" OPTION; do
	case "$OPTION" in
	C)
		LDSO_CACHE=$OPTARG
		;;
	D)
		UPDATE_CACHE=false
		UPDATE_LINKS=false
		;;
	f)
		LDSO_CONF=$OPTARG
		;;
	l)
		LIBRARY_MODE=true
		;;
	n)
		ONLYARG_MODE=true
		;;
	N)
		UPDATE_CACHE=false
		;;
	p)
		PRINT_CACHE=true
		;;
	r)
		ROOT=$OPTARG
		if ! test -f "$ROOT$LDSO_CONF"; then
			msg "${ROOT} does not appear to be a valid root directory"
			exit 1
		fi
		;;
	v)
		VERBOSE=true
		;;
	V)
		PRINT_VERSION=true
		;;
	X)
		UPDATE_LINKS=false
		;;
	c|i)
		msg "Ignored option -${OPTION}"
		;;
	\?)
		msg "Invalid option -${OPTARG}"
		cat >&2 <<- EOF
		Usage: $ME [-DnNvX] [-C cache] [-f conf] [-r root] [dir...]
		       $ME [-v] -l lib...
		       $ME [-v] [-C cache] [-r root] -p
		       $ME -V
		EOF
		exit 1
		;;
	esac
done
shift $((OPTIND-1))

BANNER="ldconfig ${VERSION} for musl"
LDSO_CACHE="$ROOT$LDSO_CACHE"
LDSO_CONF="$ROOT$LDSO_CONF"
LDSO_PATH="$ROOT/etc/ld-musl-@@ARCH@@.path"
LDSO_PATH_TMP="$LDSO_PATH.$$"

if $PRINT_VERSION; then
	echo "$BANNER"
	exit 0
elif $PRINT_CACHE; then
	test -r "$LDSO_PATH" && cat "$LDSO_PATH"
	exit 0
fi

$VERBOSE && echo "$BANNER"

if $LIBRARY_MODE; then
	for lib; do
		soname=$(scanelf -qS "$ROOT$lib")
		soname=${soname%% *}
	done
	exit 0
fi

# Update musl's list of library paths
if ! test -w "${LDSO_PATH%/*}"; then
	msg "You do not have permission to update ${LDSO_PATH}"
	exit 0
fi
trap 'rm -f "$LDSO_PATH_TMP"' EXIT
read_ldso_conf "$LDSO_CONF" > "$LDSO_PATH_TMP"
$VERBOSE && msg "Writing ${LDSO_PATH}"
mv "$LDSO_PATH_TMP" "$LDSO_PATH"
trap - EXIT

# Read the updated list of library paths
$ONLYARG_MODE || set -- "$@" $(cat "$LDSO_PATH")

if $UPDATE_LINKS; then
	for dir; do
		# Packages are responsible for libraries in these directories
		if test "$dir" = /lib || test "$dir" = /usr/lib; then
			continue
		fi
		$VERBOSE && msg "Scanning ${ROOT}${dir}"
		scanelf -qS "$ROOT$dir" | while read soname file; do
			link=${file%/*}/$soname
			test -f "$link" && continue
			$VERBOSE && msg "Creating link ${link}"
			ln -fns "${file##*/}" "$link"
		done
	done
fi

if $UPDATE_CACHE && test $# -gt 0; then
	touch "$LDSO_CACHE"
fi
